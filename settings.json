{
  "skillListingBudgetFraction": 0.02,
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "1",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/commands/**)"
    ],
    "defaultMode": "plan"
  },
  "model": "opusplan",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/session-start.mjs"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline-command.mjs || bash ~/.claude/statusline-command.sh",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "watch@claude-video": true
  },
  "extraKnownMarketplaces": {
    "claude-video": {
      "source": {
        "source": "github",
        "repo": "bradautomates/claude-video"
      }
    }
  },
  "outputStyle": "Concise",
  "language": "traditional chinese",
  "effortLevel": "xhigh",
  "theme": "dark",
  "editorMode": "vim",
  "vimInsertModeRemaps": {
    "jj": "<Esc>"
  },
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/commands/**)"
    ],
    "hard_deny": []
  },
  "additionalDirectories": []
}
