{
  "skillListingBudgetFraction": 0.02,
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "1",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "AGENT_BROWSER_IDLE_TIMEOUT_MS": "900000",
    "AGENT_BROWSER_SCREENSHOT_DIR": "/tmp/agent-browser/screenshots",
    "AGENT_BROWSER_DOWNLOAD_PATH": "/tmp/agent-browser/downloads"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(git add *)",
      "Bash(git commit -m \"*)",
      "Bash(git push *)",
      "PowerShell(git add *)",
      "PowerShell(git commit -m \"*)",
      "PowerShell(git push *)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/com:mands/**)",
      "Skill(update-config)"
    ],
    "defaultMode": "auto"
  },
  "model": "opusplan",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/inject-datetime.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline-command.mjs",
    "refreshInterval": 10,
    "hideVimModeIndicator": true
  },
  "enabledPlugins": {
    "watch@claude-video": true,
    "mindful-claude@mindful-claude": true,
    "image-view@claude-image-view": true,
    "cc-plugin-you-should-know@builtin": true
  },
  "extraKnownMarketplaces": {
    "claude-video": {
      "source": {
        "source": "github",
        "repo": "bradautomates/claude-video"
      }
    },
    "mindful-claude": {
      "source": {
        "source": "github",
        "repo": "halluton/Mindful-Claude"
      }
    },
    "claude-image-view": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-image-view"
      }
    }
  },
  "outputStyle": "Concise",
  "language": "traditional chinese",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "opus",
  "theme": "dark",
  "editorMode": "vim",
  "vimInsertModeRemaps": {
    "jj": "<Esc>"
  },
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(git add *)",
      "Bash(git commit -m \"*)",
      "Bash(git push *)",
      "PowerShell(git add *)",
      "PowerShell(git commit -m \"*)",
      "PowerShell(git push *)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/commands/**)"
    ],
    "hard_deny": []
  },
  "additionalDirectories": []
}
