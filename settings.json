{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingBudgetFraction": 0.02,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "AGENT_BROWSER_IDLE_TIMEOUT_MS": "900000",
    "AGENT_BROWSER_SCREENSHOT_DIR": "/tmp/agent-browser/screenshots",
    "AGENT_BROWSER_DOWNLOAD_PATH": "/tmp/agent-browser/downloads"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(git add *)",
      "Bash(git commit -m \"*)",
      "Bash(git push *)",
      "PowerShell(git add *)",
      "PowerShell(git commit -m \"*)",
      "PowerShell(git push *)",
      "Edit(~/.claude/commands/**)",
      "Skill(update-config)",
      "Bash(agent-browser snapshot *)",
      "Bash(agent-browser wait *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f *)",
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "defaultMode": "plan"
  },
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/git-secret-guard.mjs",
            "if": "Bash(*git*)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/git-secret-guard.mjs",
            "if": "PowerShell(*git*)",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; npx --yes prettier --write --ignore-unknown \"$f\"; } 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/agent-browser-session.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/agent-browser-session.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/inject-datetime.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline-command.mjs",
    "refreshInterval": 10,
    "hideVimModeIndicator": true
  },
  "enabledPlugins": {
    "watch@claude-video": true,
    "mindful-claude@mindful-claude": true,
    "image-view@claude-image-view": true,
    "cc-plugin-you-should-know@builtin": true
  },
  "extraKnownMarketplaces": {
    "claude-video": {
      "source": {
        "source": "github",
        "repo": "bradautomates/claude-video"
      },
      "autoUpdate": true
    },
    "mindful-claude": {
      "source": {
        "source": "github",
        "repo": "halluton/Mindful-Claude"
      },
      "autoUpdate": true
    },
    "claude-image-view": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-image-view"
      },
      "autoUpdate": true
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "Concise",
  "language": "Traditional Chinese (Taiwan)",
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "timeZone": "Asia/Taipei",
  "theme": "dark",
  "editorMode": "vim",
  "vimInsertModeRemaps": {
    "jj": "<Esc>"
  },
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
